gap between symbol intervals; equal or adjacent bins contribute zero.","panel":{"kind":"bars","title":"Squared interval-gap terms times n/w","a":[0.0],"a_label":"contributions","labels":["1: c/b"],"marker":0},"value":0.0,"value_label":"partial dissimilarity"},{"phase":2,"caption":"Use the gap between symbol intervals; equal or adjacent bins contribute zero.","panel":{"kind":"bars","title":"Squared interval-gap terms times n/w","a":[0.0,0.0],"a_label":"contributions","labels":["1: c/b","2: a/b"],"marker":1},"value":0.0,"value_label":"partial dissimilarity"},{"phase":2,"caption":"Use the gap between symbol intervals; equal or adjacent bins contribute zero.","panel":{"kind":"bars","title":"Squared interval-gap terms times n/w","a":[0.0,0.0,0.0],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c"],"marker":2},"value":0.0,"value_label":"partial dissimilarity"},{"phase":2,"caption":"Use the gap between symbol intervals; equal or adjacent bins contribute zero.","panel":{"kind":"bars","title":"Squared interval-gap terms times n/w","a":[0.0,0.0,0.0,0.0],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":3},"value":0.0,"value_label":"partial dissimilarity"},{"phase":3,"caption":"Here all symbols are adjacent: MINDIST is zero although the waveforms differ.","panel":{"kind":"bars","title":"Final SAX comparison contributions","a":[0.0,0.0,0.0,0.0],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":0},"value":0.0,"value_label":"final dissimilarity"},{"phase":3,"caption":"Here all symbols are adjacent: MINDIST is zero although the waveforms differ.","panel":{"kind":"bars","title":"Final SAX comparison contributions","a":[0.0,0.0,0.0,0.0],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":1},"value":0.0,"value_label":"final dissimilarity"},{"phase":3,"caption":"Here all symbols are adjacent: MINDIST is zero although the waveforms differ.","panel":{"kind":"bars","title":"Final SAX