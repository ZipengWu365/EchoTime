e.","panel":{"kind":"bars","title":"Dot-product terms / fixed full-vector norms","a":[0.0,0.0,0.0,0.09090909090909091,0.0,0.0,0.0,0.09090909090909091,0.18181818181818182,0.0,0.0,0.09090909090909091],"a_label":"contributions","labels":["aacd","abdc","abdd","acdb","adca","bacd","bdda","cabd","cdba","daac","dbac","dcab"],"marker":11},"value":0.5454545454545454,"value_label":"final distance"}],"animation_steps_en":["Slide, normalize and SAX-encode each length-eight window.","Suppress consecutive repeats and count a shared word vocabulary.","Accumulate matching word-count products, divided by vector norms.","Subtract the completed cosine similarity from one."],"echotime_status":"Possible addition","echotime_api":""}
