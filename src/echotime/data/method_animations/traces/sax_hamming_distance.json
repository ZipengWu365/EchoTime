th equal weight.","panel":{"kind":"bars","title":"Mismatch contributions / word length","a":[0.25,0.25],"a_label":"contributions","labels":["1: c/b","2: a/b"],"marker":1},"value":0.5,"value_label":"partial dissimilarity"},{"phase":2,"caption":"Count unequal symbols with equal weight.","panel":{"kind":"bars","title":"Mismatch contributions / word length","a":[0.25,0.25,0.25],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c"],"marker":2},"value":0.75,"value_label":"partial dissimilarity"},{"phase":2,"caption":"Count unequal symbols with equal weight.","panel":{"kind":"bars","title":"Mismatch contributions / word length","a":[0.25,0.25,0.25,0.25],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":3},"value":1.0,"value_label":"partial dissimilarity"},{"phase":3,"caption":"Hamming counts every symbol mismatch equally.","panel":{"kind":"bars","title":"Final SAX comparison contributions","a":[0.25,0.25,0.25,0.25],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":0},"value":1.0,"value_label":"final dissimilarity"},{"phase":3,"caption":"Hamming counts every symbol mismatch equally.","panel":{"kind":"bars","title":"Final SAX comparison contributions","a":[0.25,0.25,0.25,0.25],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":1},"value":1.0,"value_label":"final dissimilarity"},{"phase":3,"caption":"Hamming counts every symbol mismatch equally.","panel":{"kind":"bars","title":"Final SAX comparison contributions","a":[0.25,0.25,0.25,0.25],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":2},"value":1.0,"value_label":"final dissimilarity"},{"phase":3,"caption":"Hamming counts every symbol mismatch equally.","panel":{"kind":"bars","title":"Final SAX comparison contributions","a":[0.25,0.25,0.25,0.25],"a_label":"contributions","labels":["1: c/b","2: a/b","3: d/c","4: b/c"],"marker":3},"value":1.0,"value_label":"final dissimilarity"}],"animation